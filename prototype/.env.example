# Local Ollama server (engine "local"). Hosted endpoints are rejected for this
# engine; only loopback hosts are accepted.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3.5:9b
# LOCAL_LLM_TIMEOUT_SECONDS=120

# Hosted engine "api": DeepSeek by default, so only the key is required. It
# stays in this backend .env and is never exposed to the browser. Base URL and
# model can point at any OpenAI-compatible provider.
API_LLM_API_KEY=

# Engine switch: true = start with DeepSeek (needs API_LLM_API_KEY), false =
# local Ollama. The /demo header can still switch live until the API restarts.
USE_DEEPSEEK_API=false

# OAG Developer Portal (developers.oag.com > Subscriptions). Each API has its
# own key; paste the Primary Key of each. Keys stay in this backend .env.
# Flight Info: schedules and flight status (1,000 requests / 30 days).
# OAG_FLIGHT_INFO_KEY=
# Connections shares the Flight Info quota; Master Data allows 100 requests / 30 days.
# OAG_CONNECTIONS_KEY=
# OAG_MASTER_DATA_KEY=
